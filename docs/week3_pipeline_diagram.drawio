<mxfile host="app.diagrams.net"><diagram id="week3" name="Week 3 V1 Data Pipeline"><mxGraphModel dx="1680" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;UniNet Recommender — Week 3 V1 Data Pipeline (Event Catalogue · Pathway D: JSON / API)&lt;/b&gt;" style="text;html=1;fontSize=24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Expands the green &lt;b&gt;Event Catalogue&lt;/b&gt; component of docs/week2_architecture_v1.png. Every stage shows the operations actually executed in notebooks/week3_pipeline.ipynb (snapshot 2026-11-16, 63 events)." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1550" height="24" as="geometry"/></mxCell><mxCell id="ctx_cat" value="&lt;b&gt;Event Catalogue&lt;/b&gt; (V1)&lt;br&gt;&lt;font style='font-size:11px'&gt;expanded below&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="220" height="56" as="geometry"/></mxCell><mxCell id="ctx_emb" value="&lt;b&gt;Text Embedding Capability&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;multilingual MY/EN — Week 5&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="92" width="250" height="56" as="geometry"/></mxCell><mxCell id="ctx_nightly" value="&lt;b&gt;Nightly Model Build&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;candidates, popularity, similarity&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="92" width="250" height="56" as="geometry"/></mxCell><mxCell id="c1" value="event text" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="ctx_cat" target="ctx_emb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="event embeddings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="ctx_emb" target="ctx_nightly"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx_note" value="&lt;i&gt;Context from Week 2 (not rebuilt). Requirements served: &lt;b&gt;FR2&lt;/b&gt; semantic text for new events · &lt;b&gt;RAI3&lt;/b&gt; no personal identifiers · &lt;b&gt;RAI2&lt;/b&gt; club / language exposure evidence.&lt;/i&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1030" y="92" width="610" height="56" as="geometry"/></mxCell><mxCell id="frame" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="172" width="1640" height="498" as="geometry"/></mxCell><mxCell id="frame_label" value="&lt;b&gt;Event Catalogue — expanded into the executed V1 data pipeline&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="36" y="178" width="800" height="24" as="geometry"/></mxCell><mxCell id="s_source" value="&lt;b&gt;SOURCE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;UniNet &lt;b&gt;events&lt;/b&gt; collection&lt;br&gt;Firestore REST list endpoint&lt;br&gt;public read rule · no API key&lt;br&gt;63 documents · 1 page&lt;br&gt;JSON, typed values + nested maps&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="216" height="196" as="geometry"/></mxCell><mxCell id="s_ingest" value="&lt;b&gt;INGEST · Cell 2&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paged GET (pageSize 300)&lt;br&gt;check HTTP 200 + list shape&lt;br&gt;write .tmp → replace on success&lt;br&gt;raw snapshot + fetched_at_utc&lt;br&gt;data/raw/ (git-ignored)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="214" width="216" height="196" as="geometry"/></mxCell><mxCell id="s_inspect" value="&lt;b&gt;INSPECT · Cell 3 + A3&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;keys, Firestore value types&lt;br&gt;required fields 63/63&lt;br&gt;subset 1: 43 club-hosted&lt;br&gt;subset 2: 20 member-hosted&lt;br&gt;63/63 descriptions = Lexical JSON&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="600" y="214" width="216" height="196" as="geometry"/></mxCell><mxCell id="s_prepare" value="&lt;b&gt;PREPARE / TRANSFORM · 5D / 8D&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;decode Firestore typed values&lt;br&gt;flatten Lexical → text (lexical.ts)&lt;br&gt;mask phone / email&lt;br&gt;public-field whitelist (drop IDs)&lt;br&gt;exclude unlisted / ≥ 5 reports&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="214" width="216" height="196" as="geometry"/></mxCell><mxCell id="s_validate" value="&lt;b&gt;VALIDATE OUTPUT · B3&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;required keys · read-back equal&lt;br&gt;0 personal fields&lt;br&gt;0 raw user IDs · 0 phone/email&lt;br&gt;embedding_text non-empty 63/63&lt;br&gt;file exists, non-empty&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1160" y="214" width="216" height="196" as="geometry"/></mxCell><mxCell id="s_lineage" value="&lt;b&gt;RECORD LINEAGE · 6A/6B, 7, 9&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;source + output SHA-256&lt;br&gt;data/week3_manifest.json&lt;br&gt;pipeline_v1/json/pipeline_manifest.json&lt;br&gt;rerun PASS · Part B = Part C bytes&lt;br&gt;relative paths only&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1440" y="214" width="216" height="196" as="geometry"/></mxCell><mxCell id="e1" value="documents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s_source" target="s_ingest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s_ingest" target="s_inspect"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="valid records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s_inspect" target="s_prepare"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="prepared" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s_prepare" target="s_validate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="PASS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s_validate" target="s_lineage"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="out" value="&lt;b&gt;PREPARED OUTPUT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;b&gt;prepared_json.jsonl&lt;/b&gt; · 63 records&lt;br&gt;title, description_text, embedding_text,&lt;br&gt;type, category, flairs, host_kind, club&lt;br&gt;data/processed/ + data/pipeline_v1/json/&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1160" y="470" width="216" height="150" as="geometry"/></mxCell><mxCell id="next" value="&lt;b&gt;Text Embedding Capability&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Week 5: embed embedding_text&lt;br&gt;→ Nightly Model Build&lt;br&gt;Topic 4: quality + RAI review&lt;br&gt;(language detection, exposure)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="1440" y="470" width="216" height="150" as="geometry"/></mxCell><mxCell id="e6" value="store" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s_validate" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="describes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;endArrow=open;" edge="1" parent="1" source="s_lineage" target="out"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="445"/><mxPoint x="1336" y="445"/></Array></mxGeometry></mxCell><mxCell id="e8" value="feeds (later)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="out" target="next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1" value="&lt;b&gt;F1 · Ingest failure&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;API error, quota limit or cut-off pagination → partial catalogue silently drops new events (hurts FR2 cold start).&lt;br&gt;&lt;b&gt;Response:&lt;/b&gt; stop the run, keep the last good snapshot (.tmp write), record the HTTP status; never publish a partial catalogue.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1"><mxGeometry x="250" y="470" width="370" height="150" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;F2 · Schema change / privacy leak&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;platform adds a field (e.g. attendee list) or changes the description format → personal identifier leaks or text flattens to empty.&lt;br&gt;&lt;b&gt;Response:&lt;/b&gt; whitelist-only output fields, scan for user IDs / contacts and stop the export; flag empty-text records (description_empty) instead of dropping them.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1"><mxGeometry x="700" y="470" width="420" height="150" as="geometry"/></mxCell><mxCell id="fe1" value="" style="endArrow=none;dashed=1;strokeColor=#b85450;strokeWidth=2;html=1;" edge="1" parent="1" source="f1" target="s_ingest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe2" value="" style="endArrow=none;dashed=1;strokeColor=#b85450;strokeWidth=2;html=1;" edge="1" parent="1" source="f2" target="s_prepare"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe3" value="" style="endArrow=none;dashed=1;strokeColor=#b85450;strokeWidth=2;html=1;" edge="1" parent="1" source="f2" target="s_validate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="440"/><mxPoint x="1220" y="440"/></Array></mxGeometry></mxCell><mxCell id="deferred" value="&lt;b&gt;Not ingested in Week 3:&lt;/b&gt; Interaction &amp;amp; Impression Log (S02) — private, pseudonymous; impression logging arrives with ADR4. Needed for NFR2 learned ranking from Week 4." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="820" height="44" as="geometry"/></mxCell><mxCell id="legend_title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="752" width="100" height="22" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="782" width="28" height="18" as="geometry"/></mxCell><mxCell id="lgt0" value="Data sources &amp;amp; pipeline" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="76" y="780" width="210" height="22" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="305" y="782" width="28" height="18" as="geometry"/></mxCell><mxCell id="lgt1" value="Model &amp;amp; AI / transformation" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="341" y="780" width="210" height="22" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="570" y="782" width="28" height="18" as="geometry"/></mxCell><mxCell id="lgt2" value="Guardrails &amp;amp; controls" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="606" y="780" width="210" height="22" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="835" y="782" width="28" height="18" as="geometry"/></mxCell><mxCell id="lgt3" value="Lineage &amp;amp; evaluation" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="871" y="780" width="210" height="22" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1100" y="782" width="28" height="18" as="geometry"/></mxCell><mxCell id="lgt4" value="Failure point + response" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1136" y="780" width="210" height="22" as="geometry"/></mxCell><mxCell id="lg5" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1365" y="782" width="28" height="18" as="geometry"/></mxCell><mxCell id="lgt5" value="Deferred / later" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1401" y="780" width="210" height="22" as="geometry"/></mxCell><mxCell id="footer" value="Raw snapshot stays in data/raw/ (git-ignored: contains user IDs, names, contacts). Prepared output contains public event fields only. See docs/week3_pipeline_decisions.md for stage contracts." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="812" width="1600" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>